{
  "name": "AnchoredApp",
  "displayName": "AnchoredApp",
  "expo": {
    "name": "AnchoredApp",
    "slug": "AnchoredApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/AnchoredWhite.png",
    "splash": {
      "image": "./assets/images/AnchoredWhite.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A3C6D",
      "imageDisplay": "cover",
      "androidScaleType": "centerCrop"
    },
    "androidStatusBar": {
      "backgroundColor": "#1A3C6D",
      "barStyle": "light-content"
    },
    "androidNavigationBar": {
      "backgroundColor": "#1A3C6D"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anchored.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/AnchoredWhite.png",
        "backgroundColor": "#1A3C6D"
      },
      "package": "com.anchored.app"
    },
    "web": {
      "favicon": "./assets/images/AnchoredWhite.png"
    },
    "extra": {
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}
