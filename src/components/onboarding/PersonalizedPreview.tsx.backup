    color: Colors.mediumGray,
    marginBottom: 4,
  },
  previewText: {
    fontSize: 14,
    color: Colors.darkerGray,
    lineHeight: 20,
    fontStyle: 'italic',
  },
  milestoneContainer: {
    backgroundColor: Colors.white,
    borderRadius: 12,
    padding: 16,
    marginBottom: 12,
    borderLeftWidth: 4,
    borderLeftColor: Colors.anchorBlue,
  },
  milestoneHeader: {
    flexDirection: 'row',
    alignItems: 'center',
    marginBottom: 8,
  },
  milestoneIcon: {
    width: 32,
    height: 32,
    borderRadius: 16,
    backgroundColor: `${Colors.anchorBlue}20`,
    justifyContent: 'center',
