    flex: 1,
    height: 6,
    backgroundColor: 'rgba(0, 0, 0, 0.08)',
    borderRadius: 3,
    marginRight: 8,
    overflow: 'hidden',
  },
  progressBarFill: {
    height: '100%',
    backgroundColor: Colors.faithGold,
    borderRadius: 3,
  },
  progressText: {
    fontSize: 12,
    color: Colors.trustGrey,
    fontFamily: Fonts.semiBold,
    minWidth: 50,
    textAlign: 'right',
  },
  
  // Card Content
  cardContent: {
    padding: 16,
  },
  summaryText: {
    fontSize: 14,
    color: Colors.trustGrey,
    fontFamily: Fonts.regular,
    lineHeight: 20,
    marginBottom: 16,
  },
  
  // User Input Section
  userInputContainer: {
    backgroundColor: 'rgba(10, 132, 255, 0.03)',
    borderRadius: 8,
