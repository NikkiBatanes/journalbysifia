: boolean;\n  setShowUserInput: (show: boolean) => void;\n  chevronStyle: StyleProp<ViewStyle>;\n  styles: { [key: string]: ViewStyle | TextStyle };\n  viewMode: 'stack' | 'document';\n  setViewMode: (mode: 'stack' | 'document') => void;\n}\n\nconst PlaybookInfoSection: React.FC<PlaybookInfoSectionProps> = ({\n  playbook,\n  showUserInput,\n  setShowUserInput,\n  chevronStyle,\n  styles,\n  viewMode,\n  setViewMode,\n}) => {\n  // Calculate completed tasks from actionSteps\n  const completedTasks = playbook.actionSteps.filter(step => step.completed).length;\n\n  // Handle two-line title format from the playbook\n  const titleLines = playbook.title.split('\\n').map(line => line.trim()).filter(line => line);\n  const firstLine = titleLines[0] || '';\n  const secondLine = titleLines[1] || '';\n\n  return (\n    <View style={styles.playbookInfoContainer}>\n      <View style={styles.playbookHeader}>\n        <TouchableOpacity\n          style={styles.playbookLabelRow}\n          onPress={() => setShowUserInput(!showUserInput)}\n          activeOpacity={0.7}\n        >\n          <ThemedText weight=\"semiBold\" style={styles.playbookLabel}>PLAYBOOK</ThemedText>\n          <Animated.View style={chevronStyle}>\n            <Ionicons\n              name=\"chevron-down\"\n              size={15}\n              color={Colors.anchorBlue}\n            />\n          </Animated.View>\n        </TouchableOpacity>\n        {/* User Input Card - Collapsible */}\n        {showUserInput && playbook.userInput && (\n          <View style={styles.userInputCard}>\n            <ThemedText weight=\"regular\" style={styles.userInputText}>{playbook.userInput}</ThemedText>\n          </View>\n        )}\n        <ThemedText weight=\"bold\" style={styles.playbookTitle}>\n          {firstLine}\n        </ThemedText>\n        {secondLine ? (\n          <ThemedText weight=\"bold\" style={styles.playbookTitleSecondLine}>\n            {secondLine}\n          </ThemedText>\n        ) : null}\n        {/* Creation Date */}\n        <ThemedText weight=\"regular\" style={styles.creationDate}>\n          {new Date(playbook.createdAt || new Date()).toLocaleDateString('en-US', {\n            weekday: 'long',\n            year: 'numeric',\n            month: 'long',\n            day: 'numeric',\n          }).toUpperCase()}\n        </ThemedText>\n        {/* Progress and View Toggle Row */}\n        <View style={styles.progressAndViewRow}>\n          {/* Progress bar and text */}\n          <View style={styles.progressContainer}>\n            <View style={styles.progressRow}>\n              <View style={styles.progressBarBg}>\n                <View\n                  style={[\n                    styles.progressBarFill,\n                    { width: `${playbook.progress || 0}%` },\n                  ]}\n                />\n              </View>\n              <ThemedText weight=\"semiBold\" style={styles.progressText}>\n                {completedTasks}/{playbook.totalTasks || 0} Steps\n              </ThemedText>\n            </View>\n          </View>\n          {/* View mode toggles */}\n          <View style={styles.viewToggleContainer}>\n            <TouchableOpacity\n              style={styles.viewToggle}\n              onPress={() => setViewMode('stack')}\n            >\n              <View style={[styles.iconContainer, viewMode === 'stack' && styles.iconContainerActive]}>\n                <Ionicons\n                  name=\"albums\"\n                  size={20}\n                  color={viewMode === 'stack' ? Colors.hopeWhite : Colors.trustGrey}\n                  style={{ transform: [{ rotate: '180deg' }] }}\n                />\n              </View>\n            </TouchableOpacity>\n            <View style={styles.viewToggleDivider} />\n            <TouchableOpacity\n              style={styles.viewToggle}\n              onPress={() => setViewMode('document')}\n            >\n              <View style={[styles.iconContainer, viewMode === 'document' && styles.iconContainerActive]}>\n                <MaterialCommunityIcons\n                  name=\"view-agenda\"\n                  size={20}\n                  color={viewMode === 'document' ? Colors.hopeWhite : Colors.trustGrey}\n                />\n              </View>\n            </TouchableOpacity>\n          </View>\n        </View>\n      </View>\n    </View>\n  );\n};\n\nexport default PlaybookInfoSection;\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/func-call-spacing","replacedBy":["@stylistic/ts/func-call-spacing"]},{"ruleId":"comma-dangle","replacedBy":[]},{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-negated-in-lhs","replacedBy":["no-unsafe-negation"]},{"ruleId":"no-floating-decimal","replacedBy":[]},{"ruleId":"semi-spacing","replacedBy":[]},{"ruleId":"no-catch-shadow","replacedBy":["no-shadow"]},{"ruleId":"handle-callback-err","replacedBy":[]},{"ruleId":"no-mixed-requires","replacedBy":[]},{"ruleId":"no-new-require","replacedBy":[]},{"ruleId":"no-path-concat","replacedBy":[]},{"ruleId":"no-restricted-modules","replacedBy":[]},{"ruleId":"jsx-quotes","replacedBy":[]},{"ruleId":"eol-last","replacedBy":[]},{"ruleId":"new-parens","replacedBy":[]},{"ruleId":"no-new-object","replacedBy":["no-object-constructor"]},{"ruleId":"no-trailing-spaces","replacedBy":[]},{"ruleId":"no-mixed-spaces-and-tabs","replacedBy":[]},{"ruleId":"quotes","replacedBy":[]},{"ruleId":"semi","replacedBy":[]},{"ruleId":"space-infix-ops","replacedBy":[]},{"ruleId":"space-unary-ops","replacedBy":[]}]},{"filePath":"/Users/nikkimaebatanes/CascadeProjects/siFia/src/components/PlaybookSkeletonLoader.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"@typescript-eslint/func-call-spacing","replacedBy":["@stylistic/ts/func-call-spacing"]},{"ruleId":"comma-dangle","replacedBy":[]},{"ruleId":"no-extra-semi","replacedBy":[]},{"ruleId":"no-negated-in-lhs","replace