# Supabase Configuration (for bare React Native, remove EXPO_PUBLIC_ prefix)
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Apple Authentication Configuration
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_BUNDLE_ID=app.sifia.com

# Apple In-App Purchase Configuration (CRITICAL FOR PRODUCTION)
APPLE_SHARED_SECRET=your_app_store_shared_secret_here

# App Store Connect API (for server-side subscription validation)
APP_STORE_CONNECT_ISSUER_ID=your_issuer_id_here
APP_STORE_CONNECT_KEY_ID=UNR2UMA26W
APP_STORE_CONNECT_PRIVATE_KEY_PATH=./SubscriptionKey_UNR2UMA26W.p8

# Google Authentication Configuration
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Sentry Error Monitoring Configuration
SENTRY_DSN=DNS
SENTRY_ORG=ORG
SENTRY_PROJECT=PROJECT

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# APNS Configuration (for push notifications)
APNS_AUTH_KEY_PATH=./AuthKey_YOUR_KEY_ID.p8
APNS_KEY_ID=your_apns_key_id
APNS_TEAM_ID=your_apple_team_id
