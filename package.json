{
  "name": "journalbysifia",
  "version": "1.0.0",
  "description": "siFia mobile app",
  "private": true,
  "op-sqlite": {
    "sqlcipher": true
  },
  "codegenConfig": {
    "name": "JournalArchiveCryptoSpec",
    "type": "modules",
    "jsSrcsDir": "src/native",
    "android": {
      "javaPackageName": "app.journal.sifia.archivecrypto"
    },
    "ios": {
      "modules": {
        "JournalArchiveCrypto": {
          "className": "JournalArchiveCrypto"
        }
      }
    }
  },
