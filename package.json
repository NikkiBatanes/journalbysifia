    "security:journal-archive-crypto:portable-vectors:test": "node --test scripts/check-journal-archive-crypto-portable-vectors.test.cjs",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "ios:release": "npx react-native run-ios --mode Release",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "build:gospel-web": "bash scripts/build-gospel-share-web.sh",
    "postinstall": "patch-package",
    "fix-testflight": "bash scripts/fix-third-party-components.sh"
