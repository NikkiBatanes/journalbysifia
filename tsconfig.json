{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "jsx": "react",
    "types": ["node", "jest"],
    "typeRoots": [
      "./node_modules/@types",
      "./src/@types"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "exclude": [
    "supabase",
    "src/testing/**",
    "src/utils/phase2Validation.ts"
  ],
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
